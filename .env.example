# Stand-In configuration. Copy to .env and fill in. Never commit .env.

# offline = SimCarrier + scripted/LocalLlm LLM + SQLite + browser TTS; aws = Bedrock/Polly/DynamoDB
STANDIN_MODE=offline

# Bearer token required by the MCP server (generate a long random string locally).
# If unset in offline mode on 127.0.0.1, the server makes a one-time token that only the local sim page receives.
STANDIN_TOKEN=change-me-local-dev-token

# HTTP port for the MCP server
PORT=3000
# Allowed Origin for MCP Streamable HTTP requests
STANDIN_ALLOWED_ORIGINS=http://localhost:5173

# Storage (offline mode)
SQLITE_PATH=./standin.db

# AWS (aws mode only) -- use your local AWS profile / SSO, never hard-coded keys
AWS_REGION=ap-south-1
AWS_PROFILE=
BEDROCK_MODEL_ID=
DYNAMODB_TABLE=standin
POLLY_VOICE=Kajal

# Local LLM fallback (OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=local-model

# Call limits
MAX_CALL_MINUTES=25
CALL_TIMEZONE=Asia/Kolkata

# MCP server (apps/mcp-server). Blank values are treated as unset.
# HOST=127.0.0.1 locally; HOST=0.0.0.0 in a cloud container.
HOST=127.0.0.1
# Comma list of allowed Host headers (DNS-rebinding protection; loopback names are always allowed when bound to 127.0.0.1)
STANDIN_ALLOWED_HOSTS=
# Hosted judge demo only: /sim/config hands STANDIN_TOKEN to the static page
DEMO_EMBED_TOKEN=false
# Public URL used in the /.well-known discovery documents (defaults to the request origin)
PUBLIC_BASE_URL=
# Behind a reverse proxy (Render/Fly/App Runner): trust X-Forwarded-For / -Proto
TRUST_PROXY=false
# Number of trusted proxies in front of the server; the client IP is the X-Forwarded-For entry this far from the right
TRUST_PROXY_HOPS=1
# Per-IP token bucket for /mcp and /sim/api
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60
# Cost guards when /sim/api/llm and /sim/api/tts reach Bedrock/LocalLlm or Polly
# (the hosted demo token is public). Over a limit: scripted answers / browser speech.
SIM_LLM_RPS=1
SIM_LLM_BURST=12
SIM_TTS_RPS=3
SIM_TTS_BURST=30
SIM_LLM_HOURLY_CAP=300
SIM_TTS_HOURLY_CAP=1500
# Name used in the AI disclosure when the host gives none
STANDIN_USER_NAME=Mahal
# Sim call pacing: sim ms per real ms while talking / on hold / while the Echo rings
SIM_SPEED_TALK=2
SIM_SPEED_HOLD=30
SIM_SPEED_HANDOFF=1
# Follow-up ticker interval (ms)
FOLLOWUP_TICK_MS=2000
# Polly voice for the Echo (left pane) in aws mode
POLLY_VOICE_ALEXA=Joanna
# Use the IST wall clock for the 09:00-20:00 calling window instead of the simulated hour 14
STRICT_CALLING_HOURS=false
