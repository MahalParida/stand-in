# Stand-In configuration. Copy to .env and fill in. Never commit .env.

# offline = SimCarrier + scripted LLM (or OpenAI with STANDIN_LLM=openai) + SQLite + browser TTS; aws = Bedrock/Polly/DynamoDB
STANDIN_MODE=offline

# Bearer token required by the MCP server (generate a long random string locally).
# If unset in offline mode on 127.0.0.1, the server makes a one-time token that only the local sim page receives.
STANDIN_TOKEN=change-me-local-dev-token

# HTTP port for the MCP server
PORT=3000
# Allowed Origin for MCP Streamable HTTP requests
STANDIN_ALLOWED_ORIGINS=http://localhost:5173

# Storage (offline mode)
SQLITE_PATH=./standin.db

# AWS (aws mode only) -- use your local AWS profile / SSO, never hard-coded keys
AWS_REGION=ap-south-1
AWS_PROFILE=
BEDROCK_MODEL_ID=
DYNAMODB_TABLE=standin
POLLY_VOICE=Kajal

# Call limits
MAX_CALL_MINUTES=25
CALL_TIMEZONE=Asia/Kolkata

# MCP server (apps/mcp-server). Blank values are treated as unset.
# HOST=127.0.0.1 locally; HOST=0.0.0.0 in a cloud container.
HOST=127.0.0.1
# Comma list of allowed Host headers (DNS-rebinding protection; loopback names are always allowed when bound to 127.0.0.1)
STANDIN_ALLOWED_HOSTS=
# Hosted judge demo only: /sim/config hands STANDIN_TOKEN to the static page
DEMO_EMBED_TOKEN=false
# Public https URL of this server (tunnel or Lightsail service URL, no trailing slash). It defines the OAuth
# issuer and the canonical MCP resource ${PUBLIC_BASE_URL}/mcp, which must equal the endpoint in the Alexa+
# addon.json. Required with OAUTH_CLIENT_ID unless HOST is loopback (then it is taken from the request).
PUBLIC_BASE_URL=
# Behind a reverse proxy (Render/Fly/App Runner): trust X-Forwarded-For / -Proto
TRUST_PROXY=false
# Number of trusted proxies in front of the server; the client IP is the X-Forwarded-For entry this far from the right
TRUST_PROXY_HOPS=1
# Per-IP token bucket for /mcp and /sim/api
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60
# Cost guards when /sim/api/llm and /sim/api/tts reach Bedrock/OpenAI or Polly
# (the hosted demo token is public). Over a limit: scripted answers / browser speech.
SIM_LLM_RPS=1
SIM_LLM_BURST=12
SIM_TTS_RPS=3
SIM_TTS_BURST=30
SIM_LLM_HOURLY_CAP=300
SIM_TTS_HOURLY_CAP=1500
# Daily spend caps, counted per UTC day across all clients (in memory; a restart starts a fresh day count,
# the hourly caps still bound it). Once reached, /sim/api/llm answers with the scripted orchestrator and
# /sim/api/tts returns 204 (browser voice) until 00:00 UTC; the page shows a small "demo budget reached" note.
# Bedrock output is also capped at 512 tokens per request for the planner and the orchestrator.
SIM_LLM_DAILY_CAP=400
SIM_TTS_DAILY_CAP=1000
# Polly bills per character, so /sim/api/tts is also metered in synthesized characters (hourly and per UTC day).
# Each request carries at most 600 characters. 50k chars/day is about $0.80/day at neural list prices.
SIM_TTS_HOURLY_CHAR_CAP=15000
SIM_TTS_DAILY_CHAR_CAP=50000
# Name used in the AI disclosure when the host gives none
STANDIN_USER_NAME=Mahal
# Sim call pacing: sim ms per real ms while talking / on hold / while the Echo rings
SIM_SPEED_TALK=2
SIM_SPEED_HOLD=30
SIM_SPEED_HANDOFF=1
# Follow-up ticker interval (ms)
FOLLOWUP_TICK_MS=2000
# Follow-up scheduler: local (SQLite jobs + in-process ticker, the default in every mode) or eventbridge.
# eventbridge is used only when STANDIN_MODE=aws as well, and needs a target that runs the job (e.g. a Lambda)
# plus the role EventBridge Scheduler assumes. The single-container deploy has no such target: keep local.
SCHEDULER=local
SCHEDULER_TARGET_ARN=
SCHEDULER_ROLE_ARN=
SCHEDULER_GROUP_NAME=default
# Transcript privacy (spec 13): cases with their calls and transcripts are purged this many days after
# their last update (cases with a pending follow-up are kept); the purge runs every RETENTION_SWEEP_MS.
# Transcripts are masked at write time; delete_case erases one case on request.
TRANSCRIPT_TTL_DAYS=30
RETENTION_SWEEP_MS=3600000
# Polly voice for the Echo (left pane) in aws mode
POLLY_VOICE_ALEXA=Joanna
# Use the IST wall clock for the 09:00-20:00 calling window instead of the simulated hour 14
STRICT_CALLING_HOURS=false

# Optional real LLM for local demo/eval; never used in aws mode (aws always uses Bedrock).
# STANDIN_LLM=openai selects it for the local server; `pnpm eval --llm openai` reads this block from .env.
# STANDIN_LLM=scripted
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# off for models that accept temperature; minimal|low|medium|high for reasoning models
OPENAI_REASONING_EFFORT=off
OPENAI_TIMEOUT_MS=60000

# --- Alexa+ account linking (built-in OAuth 2.1 server: /authorize, /token; see alexa-addon/README.md) ---
# Setting OAUTH_CLIENT_ID turns it on. /mcp then accepts STANDIN_TOKEN or an OAuth access token.
# Client id you also give to `alexa-ai configure-account-linking --client-id` (any random string, e.g. standin-alexa)
OAUTH_CLIENT_ID=
# Client secret (>= 16 chars, >= 24 for Lightsail; generate locally, never commit). REQUIRED whenever the server
# is reachable beyond loopback (PUBLIC_BASE_URL set to a public host, or HOST not loopback); only a loopback-only
# dev server may run a public PKCE-only client. Give the same value to the Alexa AI CLI through its masked prompt
# or ALEXA_CLIENT_SECRET, never as a flag.
OAUTH_CLIENT_SECRET=
# Exact-match allowlist of redirect URIs (comma list). Paste every URI the CLI / Developer Hub shows
# after configure-account-linking, e.g. https://alexa.amazon.com/api/skill/link/<vendor-id>
OAUTH_REDIRECT_URIS=
# Scopes advertised in scopes_supported; Alexa requests these during linking
OAUTH_SCOPES=standin
# Passcode the consent page asks for (>= 8 chars), so strangers cannot link the hosted demo. REQUIRED whenever
# the server is reachable beyond loopback (same rule as OAUTH_CLIENT_SECRET).
OAUTH_LINK_PASSCODE=
# Wrong passcodes allowed per rolling hour across all linking requests (a third of it per client IP). Once spent,
# approvals are refused until the hour clears, even with the right passcode.
OAUTH_PASSCODE_MAX_FAILURES=20
# Token lifetimes: access token seconds, refresh token days (rotated on every use), authorization code seconds
OAUTH_ACCESS_TTL_SEC=3600
OAUTH_REFRESH_TTL_DAYS=30
OAUTH_CODE_TTL_SEC=60
# Alexa+ lists the tools at `alexa-ai deploy`, before anyone has linked. Set BOTH to true for Alexa+
# (alexa-addon/README.md step 2). Blank = false for the server; scripts/deploy-lightsail.sh treats blank as true
# when OAUTH_CLIENT_ID is set.
# Tier 1 client_credentials grant (mcp:service tokens for initialize/tools/list only). Needs OAUTH_CLIENT_SECRET.
OAUTH_CLIENT_CREDENTIALS=
# Let initialize/tools/list through without a token (tools/call and everything else still answer 401).
MCP_PUBLIC_DISCOVERY=
# Contact line on /privacy and /terms
STANDIN_CONTACT=
