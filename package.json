{
  "name": "stand-in",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "eval": "pnpm --filter @standin/eval run eval",
    "verify": "tsx packages/core/src/verify-cli.ts",
    "demo": "pnpm --filter \"@standin/alexa-sim...\" --filter \"@standin/mcp-server...\" build && pnpm --filter @standin/mcp-server start:offline",
    "deploy:lightsail": "bash scripts/deploy-lightsail.sh",
    "smoke:live": "bash scripts/smoke-live.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
